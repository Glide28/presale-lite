# --- Модель ---
# mock  — офлайн-режим без ключа (демо и тесты)
# openai — любой OpenAI-совместимый API (OpenAI, OpenRouter, Gemini и др.)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-flash
# Пустое значение — не передавать temperature (нужно для моделей, которые его не принимают)
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=240
# Только OpenRouter: ускорение и ограничения (необязательно)
LLM_REASONING_EFFORT=none
LLM_PROVIDER_SORT=throughput
# LLM_MAX_TOKENS=6000

# --- Прочее ---
# Токен API. Если задаёте, то он должен совпадать у backend и интерфейса; для локального запуска лучше не трогать.
# API_TOKEN=change-me
# Только для Docker (путь внутри контейнера). Для локального запуска не задавайте:
# DB_PATH=/data/presale.db
